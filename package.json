{
  "name": "productivity-police",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first Chrome extension for user-defined focus rules.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm --filter @productivity-police/extension build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit --pretty false",
    "validate": "pnpm quality && pnpm test",
    "validate:full": "pnpm quality && pnpm test:unit && pnpm test:integration && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/chrome": "0.2.8",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
